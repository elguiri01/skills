#!/usr/bin/env bash
# ccs - attach or create a tmux session running Claude Code for a project.
#
#   ccs                  session for $PWD, new conversation
#   ccs ~/orchestrator   session for that directory
#   ccs -c [dir]         new session, continue that directory's last conversation
#   ccs -r [dir]         new session, open the resume picker
#   ccs -l               list the Claude tmux sessions
#
# Attaching to an existing session is the common case: a dropped SSH
# connection leaves the session and its in-flight turn running on the
# droplet, so you rejoin the live process and -c does not come into it.
# -c and -r only affect how a NEW session starts.
#
# Runs on a dedicated tmux server (-L claude), so it never disturbs other
# tmux sessions. To reach them by hand: tmux -L claude ls
#
# Named ccs and not cc, because cc is the C compiler.

set -euo pipefail

SOCKET="${CCS_TMUX_SOCKET:-claude}"
CONF="${CCS_TMUX_CONF:-$HOME/.config/tmux/claude.conf}"
CLAUDE_BIN="${CCS_CLAUDE_BIN:-claude}"

tm() { tmux -L "$SOCKET" -f "$CONF" "$@"; }

usage() { sed -n '2,17p' "$0" | sed 's/^#\( \|$\)//'; }

mode=new
while [ $# -gt 0 ]; do
  case "$1" in
    -c|--continue) mode=continue; shift ;;
    -r|--resume)   mode=resume;   shift ;;
    -l|--list)   tm list-sessions 2>/dev/null || echo "no Claude sessions running"; exit 0 ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; break ;;
    -*)          echo "ccs: unknown option: $1" >&2; exit 2 ;;
    *)           break ;;
  esac
done

[ -f "$CONF" ] || { echo "ccs: config not found at $CONF (see droplet-tmux/README.md)" >&2; exit 1; }

dir="${1:-$PWD}"
[ -d "$dir" ] || { echo "ccs: no such directory: $dir" >&2; exit 1; }
dir="$(cd "$dir" && pwd -P)"

name="ccs-$(basename "$dir" | tr -c 'A-Za-z0-9_' '-' | sed 's/-*$//')"

# Attach to the session, switching in place if we are already on this server.
attach() {
  if [ -n "${TMUX:-}" ]; then
    here="$(tmux display-message -p '#{socket_path}' 2>/dev/null || true)"
    there="$(tm display-message -p '#{socket_path}' 2>/dev/null || true)"
    if [ -n "$here" ] && [ "$here" = "$there" ]; then
      tm switch-client -t "=$name"
      return
    fi
    echo "ccs: already inside a different tmux server. Detach first, or run:" >&2
    echo "    tmux -L $SOCKET attach -t $name" >&2
    return 1
  fi
  if [ ! -t 1 ]; then
    echo "ccs: session '$name' is running (no tty here, not attaching)"
    return 0
  fi
  tm attach-session -t "=$name"
}

if tm has-session -t "=$name" 2>/dev/null; then
  [ -t 1 ] || echo "ccs: attaching to existing session '$name'"
  attach
  exit $?
fi

# A new session starts fresh unless asked otherwise. -c can still fail with
# "No conversation found to continue"; -r opens the picker either way and is
# the safer choice when you are not sure what history a directory has.
case "$mode" in
  continue) start="$CLAUDE_BIN --continue" ;;
  resume)   start="$CLAUDE_BIN --resume" ;;
  new)      start="$CLAUDE_BIN" ;;
esac

# Capture the pane id, so send-keys does not depend on window/pane indexes.
pane="$(tm new-session -d -P -F '#{pane_id}' -s "$name" -c "$dir")"
tm send-keys -t "$pane" "$start" C-m
attach
